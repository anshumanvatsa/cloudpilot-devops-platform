APP_NAME=CloudPilot Backend
ENVIRONMENT=production
API_PREFIX=/api
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=postgresql+psycopg://cloudpilot:cloudpilot@postgres:5432/cloudpilot
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost,http://YOUR_EC2_IP
RATE_LIMIT=100/minute
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
REFRESH_COOKIE_NAME=cloudpilot_refresh
CSRF_COOKIE_NAME=cloudpilot_csrf
CSRF_HEADER_NAME=X-CSRF-Token
BUILD_DIR=/tmp/cloudpilot_builds
TRAEFIK_DOMAIN=localhost
PUBLIC_BASE_URL=http://YOUR_EC2_IP
